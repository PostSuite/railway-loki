worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 128;
}

http {
    access_log /dev/stdout;

    server {
        listen ${PORT};

        # Health check — no auth required (Railway needs this)
        location = /ready {
            proxy_pass http://127.0.0.1:3100/ready;
        }

        # All other requests require a recognized credential. Either:
        #   Authorization: Bearer $AUTH_TOKEN          (backend services)
        #   api-key: $MODAL_AUTH_TOKEN                 (Modal OTEL integration)
        # Matches Modal's documented OTEL_HEADER_api-key convention. Note:
        # header names with underscores are dropped by nginx by default
        # (underscores_in_headers off), so the Modal header must stay
        # hyphenated — created via Modal's UI OpenTelemetry Secret template,
        # not the CLI (which rejects hyphens in secret keys).
        # Distinct tokens so Modal can be rotated independently.
        location / {
            set $auth_ok 0;
            if ($http_authorization = "Bearer ${AUTH_TOKEN}") { set $auth_ok 1; }
            if ($http_api_key = "${MODAL_AUTH_TOKEN}") { set $auth_ok 1; }
            if ($auth_ok = 0) {
                return 401 '{"error": "unauthorized"}';
            }

            proxy_pass http://127.0.0.1:3100;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
        }
    }
}
