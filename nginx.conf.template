worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 128;
}

http {
    # TEMP: capture auth headers to diagnose Modal 401s. Revert after
    # confirmation. Full header values land in Railway logs (operator-only),
    # still revert promptly.
    log_format debug_auth '$remote_addr "$request" $status '
                          'x-api-key="$http_x_api_key" '
                          'authorization="$http_authorization" '
                          'ua="$http_user_agent"';
    access_log /dev/stdout debug_auth;

    server {
        listen ${PORT};

        # Health check — no auth required (Railway needs this)
        location = /ready {
            proxy_pass http://127.0.0.1:3100/ready;
        }

        # All other requests require a recognized credential. Either:
        #   Authorization: Bearer $AUTH_TOKEN          (backend services)
        #   x-api-key: $MODAL_AUTH_TOKEN               (Modal OTEL integration)
        # Distinct tokens so Modal can be rotated independently.
        location / {
            set $auth_ok 0;
            if ($http_authorization = "Bearer ${AUTH_TOKEN}") { set $auth_ok 1; }
            if ($http_x_api_key = "${MODAL_AUTH_TOKEN}") { set $auth_ok 1; }
            if ($auth_ok = 0) {
                return 401 '{"error": "unauthorized"}';
            }

            proxy_pass http://127.0.0.1:3100;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
        }
    }
}
