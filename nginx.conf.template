worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 128;
}

http {
    access_log /dev/stdout;

    server {
        listen ${PORT};

        # Health check — no auth required (Railway needs this)
        location = /ready {
            proxy_pass http://127.0.0.1:3100/ready;
        }

        # All other requests require a bearer token.
        #
        # Modal OTEL path (disabled 2026-04-22, may be re-enabled). To restore:
        #   1. uncomment the `api-key` check below;
        #   2. set MODAL_AUTH_TOKEN on the Loki Railway service;
        #   3. add ${MODAL_AUTH_TOKEN} back to envsubst in entrypoint.sh;
        #   4. create the Modal secret via the UI OpenTelemetry Secret
        #      template (CLI rejects hyphenated keys) with key
        #      `OTEL_HEADER_api-key` and the MODAL_AUTH_TOKEN value.
        #   Note: nginx drops headers with underscores in the name by default
        #   (`underscores_in_headers off`), so the Modal header must stay
        #   hyphenated (`api-key`, not `x_api_key`).
        location / {
            set $auth_ok 0;
            if ($http_authorization = "Bearer ${AUTH_TOKEN}") { set $auth_ok 1; }
            # if ($http_api_key = "${MODAL_AUTH_TOKEN}") { set $auth_ok 1; }
            if ($auth_ok = 0) {
                return 401 '{"error": "unauthorized"}';
            }

            proxy_pass http://127.0.0.1:3100;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
        }
    }
}
